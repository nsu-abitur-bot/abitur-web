# URL для бэкенд API (без слеша в конце)
# Например: http://10.5.10.190:8000
NUXT_PUBLIC_API_BASE_URL=http://10.5.10.190:8000

# Пароль для подписи session cookie, минимум 32 символа.
# Для реального окружения сгенерируйте новый: openssl rand -hex 32
NUXT_SESSION_PASSWORD=local-session-password-min-32-chars

# Локальная БД для docker compose.
POSTGRES_DB=abitur_web
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
NUXT_DATABASE_URL=postgres://postgres:postgres@db:5432/abitur_web
